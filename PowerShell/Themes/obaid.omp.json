{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }} · pwsh",
  "shell_integration": true,
  "upgrade": {
    "notice": false,
    "auto": false
  },
  "palette": {
    "void": "#0b0e14",
    "surface": "#1e2233",
    "line": "#3b4261",
    "dim": "#6b7089",
    "text": "#c8d3f5",
    "cyan": "#7de2ff",
    "violet": "#a277ff",
    "magenta": "#ff6ac1",
    "mint": "#5ef1b3",
    "amber": "#ffd580",
    "red": "#ff5c8a"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:line",
          "template": "╭─"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:cyan",
          "template": " <b> {{ .Path }}</b>",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "…",
            "folder_separator_icon": "<p:line>  </>",
            "home_icon": " ~"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:violet",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:amber{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:magenta{{ end }}",
            "{{ if gt .Ahead 0 }}p:cyan{{ end }}"
          ],
          "template": "   {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <p:amber> {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <p:mint> {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} <p:dim> {{ .StashCount }}</>{{ end }}",
          "properties": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:mint",
          "template": "  {{ .Full }}",
          "properties": {
            "display_mode": "files",
            "home_enabled": false
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:amber",
          "template": "  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}",
          "properties": {
            "display_mode": "files",
            "home_enabled": false
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:magenta",
          "template": " 󰔛 {{ .FormattedMs }}",
          "properties": {
            "threshold": 400,
            "style": "austin"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:dim",
          "template": " 󰅐 {{ .CurrentDate | date \"15:04\" }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:line",
          "template": "╰─{{ if .Root }}<p:amber>⚡</>{{ end }}{{ if gt .Code 0 }}<p:red><b>❯</b></>{{ else }}<p:cyan><b>❯</b></>{{ end }}"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "p:cyan",
    "template": "<b>❯</b> "
  },
  "secondary_prompt": {
    "foreground": "p:line",
    "template": "│ "
  }
}
